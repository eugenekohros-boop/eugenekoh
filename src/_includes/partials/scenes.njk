{# ---------- the public macro ---------- #}

{% macro scene(name, id, tall=false, label="", align="xMidYMax") %}
{% set top = -420 if tall else 0 %}
<svg class="scene scene--{{ 'dusk' if name == 'network' else name }}" viewBox="0 {{ top }} 1200 {{ 440 - top }}" preserveAspectRatio="{{ align }} slice" role="img" aria-label="{{ label or 'Hand-drawn landscape illustration' }}" focusable="false">
  {{ defs(id, top) }}
  <rect x="-50" y="{{ top - 40 }}" width="1300" height="{{ 520 - top }}" fill="url(#{{id}}-sky)"/>
  {% if name == "meadow" %}{{ meadowScene(id, tall) }}
  {% elif name == "sunlight" %}{{ sunlightScene(id) }}
  {% elif name == "dusk" %}{{ duskScene(id) }}
  {% elif name == "network" %}{{ duskScene(id, true) }}
  {% elif name == "fungus" %}{{ fungusScene(id) }}
  {% elif name == "evolution" %}{{ evolutionScene(id) }}
  {% elif name == "pollen" %}{{ pollenScene(id) }}
  {% elif name == "greenhouse" %}{{ greenhouseScene(id) }}
  {% elif name == "pines" %}{{ pinesScene(id) }}
  {% endif %}
</svg>
{% endmacro %}
