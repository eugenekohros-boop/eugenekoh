{# Small hand-drawn style icons. Usage: {% from "partials/icons.njk" import icon %} {{ icon("sun") }} #}
{% macro icon(name, size=24, cls="") %}
<svg class="icon {{ cls }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% if name == "sun" %}
  <circle cx="12" cy="12" r="4.2" fill="var(--icon-fill, none)"/><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M5.5 18.5l1.7-1.7M16.8 7.2l1.7-1.7"/>
{% elif name == "sprout" %}
  <path d="M12 21v-8"/><path d="M12 13c0-4.5-3-7-8-7 0 4.5 3 7 8 7z" fill="var(--icon-fill, none)"/><path d="M12 11c0-3.8 2.6-6 7-6 0 3.8-2.6 6-7 6z" fill="var(--icon-fill, none)"/>
{% elif name == "leaf" %}
  <path d="M5 19C5 10 10 5 20 4c0 10-5 15-14 15z" fill="var(--icon-fill, none)"/><path d="M5 19c4-5 7-8 11-11"/>
{% elif name == "pine" %}
  <path d="M12 3l-5 7h3l-4 6h12l-4-6h3z" fill="var(--icon-fill, none)"/><path d="M12 16v5"/>
{% elif name == "flower" %}
  <circle cx="12" cy="9" r="2.2" fill="var(--icon-fill, none)"/><path d="M12 6.8c0-2.2 1-3.6 2.3-3.6S16 5 14.2 7.3M14.2 9.6c2 .7 3 2 2.4 3.2-.7 1.1-2.4.6-3.4-1.4M11 11.1c-1 2-2.7 2.5-3.4 1.4-.6-1.2.4-2.5 2.4-3.2M9.8 7.3C8 5 8.5 3.2 9.7 3.2S12 4.6 12 6.8"/><path d="M12 11.2V21M12 17c-2.5 0-4-1.4-4.5-3.2 2.4 0 3.9 1.2 4.5 3.2z"/>
{% elif name == "mushroom" %}
  <path d="M3.5 12c0-4.4 3.8-8 8.5-8s8.5 3.6 8.5 8c-2.8.8-5.6 1.1-8.5 1.1S6.3 12.8 3.5 12z" fill="var(--icon-fill, none)"/><path d="M9.5 13v5.2a2.5 2.5 0 0 0 5 0V13"/><circle cx="9" cy="8.5" r=".8" fill="currentColor"/><circle cx="14.5" cy="7.5" r=".8" fill="currentColor"/>
{% elif name == "lantern" %}
  <path d="M9 4h6M12 2v2M8 7h8l-.6 10H8.6z" fill="var(--icon-fill, none)"/><path d="M9 20h6M12 17v3"/><path d="M12 10.5c.9 1 1 2.2 0 3.2-1-1-.9-2.2 0-3.2z"/>
{% elif name == "network" %}
  <circle cx="5" cy="6" r="2" fill="var(--icon-fill, none)"/><circle cx="18" cy="5" r="2" fill="var(--icon-fill, none)"/><circle cx="12" cy="13" r="2.4" fill="var(--icon-fill, none)"/><circle cx="6" cy="19" r="2" fill="var(--icon-fill, none)"/><circle cx="19" cy="18" r="2" fill="var(--icon-fill, none)"/><path d="M6.6 7.3l3.7 4M16.6 6.4l-3.2 4.7M10.4 14.6l-3 3M14.2 14.2l3.3 2.6"/>
{% elif name == "greenhouse" %}
  <path d="M3 20V11a9 7 0 0 1 18 0v9z" fill="var(--icon-fill, none)"/><path d="M3 20h18M12 4v16M7.5 5.4V20M16.5 5.4V20M3 12h18"/>
{% elif name == "book" %}
  <path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v15H5.5A1.5 1.5 0 0 0 4 20.5z" fill="var(--icon-fill, none)"/><path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H13v15h5.5c.8 0 1.5.7 1.5 1.5z" fill="var(--icon-fill, none)"/>
{% elif name == "mic" %}
  <rect x="9" y="3" width="6" height="11" rx="3" fill="var(--icon-fill, none)"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M8.5 21h7"/>
{% elif name == "cap" %}
  <path d="M2.5 9L12 4.5 21.5 9 12 13.5z" fill="var(--icon-fill, none)"/><path d="M6.5 11v4.5c1.5 1.6 3.4 2.4 5.5 2.4s4-.8 5.5-2.4V11M21.5 9v5"/>
{% elif name == "tool" %}
  <path d="M14.5 6.5a4 4 0 0 0 5 5L12 19a2.1 2.1 0 1 1-3-3l7.5-7.5a4 4 0 0 0-2-2z" fill="var(--icon-fill, none)"/><path d="M14.5 6.5l3-3a4 4 0 0 1 3 3l-3 3"/>
{% elif name == "mail" %}
  <rect x="3" y="5.5" width="18" height="13" rx="2.5" fill="var(--icon-fill, none)"/><path d="M4 7l8 6 8-6"/>
{% elif name == "orcid" %}
  <circle cx="12" cy="12" r="9" fill="var(--icon-fill, none)"/><path d="M9 10.5V16.5M9 7.6v.1M12 10.5v6h1.8a3 3 0 0 0 0-6z"/>
{% elif name == "linkedin" %}
  <rect x="3" y="3" width="18" height="18" rx="4" fill="var(--icon-fill, none)"/><path d="M8 10.5v6M8 7.6v.1M11.5 16.5v-6M11.5 13c0-1.6 1-2.6 2.4-2.6s2.1 1 2.1 2.6v3.5"/>
{% elif name == "external" %}
  <path d="M14 4h6v6M20 4l-8.5 8.5M18 14v4.5c0 .8-.7 1.5-1.5 1.5h-11c-.8 0-1.5-.7-1.5-1.5v-11C4 6.7 4.7 6 5.5 6H10"/>
{% elif name == "arrow" %}
  <path d="M5 12h14M13 6l6 6-6 6"/>
{% elif name == "back" %}
  <path d="M19 12H5M11 6l-6 6 6 6"/>
{% elif name == "copy" %}
  <rect x="8" y="8" width="12" height="12" rx="2.5" fill="var(--icon-fill, none)"/><path d="M16 8V5.5c0-.8-.7-1.5-1.5-1.5h-9C4.7 4 4 4.7 4 5.5v9c0 .8.7 1.5 1.5 1.5H8"/>
{% elif name == "check" %}
  <path d="M5 12.5l4.5 4.5L19 7.5"/>
{% elif name == "file" %}
  <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" fill="var(--icon-fill, none)"/><path d="M14 3v5h5M9 13h6M9 17h4"/>
{% elif name == "play" %}
  <circle cx="12" cy="12" r="9" fill="var(--icon-fill, none)"/><path d="M10 8.5v7l5.5-3.5z" fill="currentColor"/>
{% elif name == "quote" %}
  <path d="M10 7c-3 .6-5 3-5 6v4h5v-5H7.5M19 7c-3 .6-5 3-5 6v4h5v-5h-2.5"/>
{% elif name == "pin" %}
  <path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z" fill="var(--icon-fill, none)"/><circle cx="12" cy="10" r="2.3"/>
{% elif name == "menu" %}
  <path d="M4 7h16M4 12h16M4 17h16"/>
{% elif name == "close" %}
  <path d="M6 6l12 12M18 6L6 18"/>
{% elif name == "cloud" %}
  <path d="M7 18h10.5a4 4 0 0 0 .5-8 5.5 5.5 0 0 0-10.6-1A4.5 4.5 0 0 0 7 18z" fill="var(--icon-fill, none)"/>
{% elif name == "flask" %}
  <path d="M9.5 3h5M10 3v6L4.8 18.2A2 2 0 0 0 6.5 21h11a2 2 0 0 0 1.7-2.8L14 9V3" fill="var(--icon-fill, none)"/><path d="M7.2 15h9.6"/>
{% elif name == "laptop" %}
  <rect x="4.5" y="5" width="15" height="10" rx="1.5" fill="var(--icon-fill, none)"/><path d="M2.5 19h19M9 9.5l-1.5 1.5L9 12.5M15 9.5l1.5 1.5-1.5 1.5"/>
{% elif name == "handshake" %}
  <path d="M3 11l4-4 4 2 3-2 4 1 3 3M3 11l5 5 2-1 1 1 2-1 1 1 2-1 3-4M11 9l-3 3"/>
{% endif %}
</svg>
{% endmacro %}
